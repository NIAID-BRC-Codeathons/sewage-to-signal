# ---------------------------------------------------------------------------
# Data. Everything here is fetched by ./src/setup.sh, never committed (~30 GB).
# See DATA.md for the source of each item.
# ---------------------------------------------------------------------------

# ESM Atlas cluster tables (~27 GB)
sae/representative_proteins.parquet
sae/sae_clusters/

# Sequencing reads (~2.5 GB)
data/fastq/*.fastq.gz
data/fastq/*.part
data/fastq_rnaseq/*.fastq.gz
data/fastq_rnaseq/*.fastq
data/fastq_rnaseq/.n1
data/fastq_rnaseq/.n2
data/fastq_rnaseq/.both

# Pfam-A — ~400 MB compressed, larger on disk; fetch with ./src/setup.sh pfam
data/pfam/

# Fitted reference layout. Derived, and a pickle whose validity depends on
# library versions — build with sae/web/reference_map.py, share the file
# deliberately rather than by committing one built from a laptop's scratch.
data/reference_map.joblib

# The store. Derived from inputs that are themselves fetched, and it grows with
# every run, so it is rebuilt rather than committed: `backfill.py` loads an
# existing work/ into it, and re-running a sample refills it.
data/sae.ducklake
data/sae.ducklake.files/
*.ducklake
*.ducklake.files/

# Pipeline outputs — all derived, regenerate with pipeline/run.py
work/

# Uploads staged by the web UI (sae/web/server.py --uploads)
uploads/

# Built container images — 3.2 GB, rebuild with container/build.sh
*.sif
container/sae-docker.tar

# Model weights live in ~/.cache/huggingface, but catch a local override too
**/hf_cache/
*.safetensors

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/

# run_batch.sh writes one log per sample here (SAE_LOGS)
logs/
